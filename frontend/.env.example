# Local frontend development: run the API on this same machine.
VITE_API_BASE_URL=http://localhost:5000

# Public registration stays visually available but must not be enabled until
# the backend enforces that unauthenticated registration can create Faculty only.
VITE_FACULTY_REGISTRATION_ENABLED=false

# For remote Preview or production, replace the local URL with your backend's
# publicly reachable HTTPS base URL and configure backend CORS for this app origin.
